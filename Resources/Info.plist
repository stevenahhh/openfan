        <key>MallocMaxMagazines</key>
        <string>1</string>
        <key>MallocSpaceEfficient</key>
        <string>1</string>
    </dict>
    <!-- Raise with every change to OpenFanHelper: the app then offers Update Helper. -->
    <key>OpenFanHelperRevision</key>
    <string>3</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSUIElement</key>
    <true/>
</dict>
</plist>
